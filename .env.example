# Optional. Server-only. Do NOT prefix with NEXT_PUBLIC_.
# On Vercel: add as Sensitive (private). Classic token with public_repo is enough
# to read public releases on this repo: https://github.com/settings/tokens
#
# Without this, Vercel’s shared IPs are often rate-limited by GitHub (60 req/hour)
# and the download cards fall back to /releases/latest with no file sizes.
GITHUB_TOKEN=

# Optional. Override the releases repo (owner/name). Default TheMagiche/LOTM-SITE.
# GITHUB_REPO=TheMagiche/LOTM-SITE
